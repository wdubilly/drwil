#!/bin/sh
# Activé par `git config core.hooksPath .githooks`. Git for Windows exécute aussi ce script via son sh.
if ! command -v node >/dev/null 2>&1; then
  echo "[ia-first] node introuvable / not found : contrôles non exécutés, commit refusé." >&2
  exit 1
fi
# DRWIL_HOOK : seul le commit peut reporter un contrôle du projet hors de ses `chemins` (voir run-checks.mjs).
DRWIL_HOOK=pre-commit exec node "$(dirname "$0")/run-checks.mjs"
