      "name": "lint et formatage du code (Biome, avertissements bloquants)",
      "run": "npm run lint",
      "ciJob": "checks",
      "paths": [
        "**/*.js",
        "**/*.mjs",
        "**/*.ts",
        "biome.jsonc",
        "package.json",
        "package-lock.json"
      ],
      "degradable": false
    },
    {
      "id": "tests-contrats",
      "name": "tests rattachés aux contrats, cohérence dans les deux sens (non-régression)",
      "run": "node outils/verifier-tests-contrats.mjs",
      "ciJob": "checks",
      "paths": [
        "docs/contracts.md",
        "**/*.test.mjs",
        "packages/drwil/test/**",
        "outils/verifier-tests-contrats.mjs",
        ".drwil/ia-first.json"
      ],
      "degradable": false
    },
    {
      "id": "audit-dependances",
      "name": "audit des dépendances, failles high et critical (SEC-006)",
      "run": "node outils/audit-dependances.mjs",
      "ciJob": "checks",
      "paths": [
        "package.json",
        "package-lock.json",
        "packages/*/package.json",
        "outils/audit-dependances.mjs",
        ".drwil/ia-first.json"
      ],
      "degradable": false
    },
    {
      "id": "tarball",
      "name": "CLI installée depuis le tarball, comme un utilisateur (contenu, --version, init, verify)",
      "run": "node outils/tester-tarball.mjs",
      "ciJob": "checks",
      "paths": [
        "packages/drwil/**",
        "package.json",
        "package-lock.json",
        "outils/tester-tarball.mjs",
        ".drwil/ia-first.json"
