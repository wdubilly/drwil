{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.githooks/etat.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/garde-fou-bash.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rappel-cadrage.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rappel-cadrage.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(**)"
    ],
    "ask": [],
    "deny": [
      "Bash(git *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Edit(**/.drwil/state.json)",
      "Write(**/.drwil/state.json)",
      "Bash(*.drwil/state.json*)"
    ]
  }
}
