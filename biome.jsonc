{
  // Lint et formatage du code de ce dépôt (docs/projets/lint-formateur-engines.md). Outil du dépôt,
  // jamais livré : chaque projet équipé déclare le sien. Toute règle désactivée l'est ici, avec sa
  // raison (QUA-019 : un contrôle ne se contourne pas en silence).
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**/*.js", "**/*.mjs", "**/*.ts", "!**/dist", "!**/node_modules"]
  },
  // Proche du style existant (guillemets doubles, points-virgules, 2 espaces). Le premier formatage,
  // le 2026-10-11, a réécrit une cinquantaine de fichiers en un commit isolé, sans aucun autre
  // changement (décision du demandeur) ; mesuré à toutes les largeurs valides (jusqu'à 320), le diff
  // restait d'environ 1 500 lignes : la largeur standard de 140 a été retenue.
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Préférence de style sans effet sur le comportement : imposer les gabarits de chaînes
        // réécrirait une cinquantaine de concaténations, dont celles des hooks livrés, pour rien.
        "useTemplate": "off"
      }
    }
  },
  "overrides": [
    {
      // Données sans type : la configuration .drwil/ia-first.json (JSON libre) et le moteur et le
      // lecteur de contrats .mjs, chargés dynamiquement depuis le projet. Les typer est un chantier
      // à part (typage strict, catalogue:QUA-005), pas un réglage de lint.
      "includes": ["packages/drwil/src/verify.ts", "packages/drwil/src/doctor.ts"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ]
}
