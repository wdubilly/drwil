#!/bin/sh
# Mêmes contrôles qu'au commit (.githooks/pre-commit), rejoués au push :
# rattrape un commit passé avec `--no-verify`, ou un hook pre-commit pas
# encore activé sur ce poste. Git for Windows exécute aussi ce script via son sh.
if ! command -v node >/dev/null 2>&1; then
  echo "[ia-first] node introuvable / not found : contrôles non exécutés, push refusé." >&2
  exit 1
fi
exec node "$(dirname "$0")/run-checks.mjs"
