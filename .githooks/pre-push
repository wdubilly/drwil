#!/bin/sh
# Mêmes contrôles qu'au commit (.githooks/pre-commit), rejoués au push :
# rattrape un commit passé avec `--no-verify`, ou un hook pre-commit pas
# encore activé sur ce poste. Git for Windows exécute aussi ce script via son sh.
if ! command -v node >/dev/null 2>&1; then
  echo "[ia-first] node introuvable / not found : contrôles non exécutés, push refusé." >&2
  exit 1
fi

# QUA-017 ne doit jamais bloquer un push qui ne pousse que des tags (il ne
# touche aucune branche). Protocole standard du hook pre-push : une ligne par
# référence poussée sur l'entrée standard, `<local ref> <local sha1> <remote
# ref> <remote sha1>` — seule source fiable de ce qui est réellement poussé
# (contrairement à la branche courante, inchangée pendant un push de tag).
# Dès qu'une référence poussée n'est pas un tag (ex. push mixte tag + branche),
# le contrôle s'applique normalement, par prudence.
une_reference=0
que_des_tags=1
while IFS=' ' read -r local_ref local_sha1 remote_ref remote_sha1; do
  une_reference=1
  case "$remote_ref" in
    refs/tags/*) ;;
    *) que_des_tags=0 ;;
  esac
done

if [ "$une_reference" = "1" ] && [ "$que_des_tags" = "1" ]; then
  DRWIL_PUSH_TAGS_ONLY=1 exec node "$(dirname "$0")/run-checks.mjs"
fi
exec node "$(dirname "$0")/run-checks.mjs"
